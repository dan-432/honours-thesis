   author = {Altschul, S. F. and Madden, T. L. and Schäffer, A. A. and Zhang, J. and Zhang, Z. and Miller, W. and Lipman, D. J.},
   title = {Gapped BLAST and PSI-BLAST: a new generation of protein database search programs},
